# Copy this to `.env` on the VPS (next to docker-compose.yml) and fill in
# real values. Never commit the real .env — it's git-ignored.

# ---- Postgres (isolated instance, this app only) ----
POSTGRES_USER=vertinary
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=vertinary_db

# ---- Backend app config (see backend/app/core/config.py for the full list) ----
SECRET_KEY=CHANGE_ME_LONG_RANDOM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Same-origin via nginx makes this mostly moot for browser calls, but keep it
# correct for direct API/docs access.
CORS_ORIGINS=http://VPS_IP:8080

UPLOAD_DIR=/app/uploads
STORAGE_BACKEND=local
MAX_LESSON_FILE_SIZE_MB=1024
MEDIA_TOKEN_EXPIRE_MINUTES=360
UVICORN_WORKERS=2

# SMTP — leave VERIFICATION_EMAIL_MODE=console until real SMTP creds exist
# (verification/reset links print to `docker compose logs backend` instead
# of being emailed).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-domain.example
VERIFICATION_EMAIL_MODE=console

# MUST point at the real public origin so emailed links resolve correctly.
# Update these (and CORS_ORIGINS above) the day the domain goes live — that
# plus a TLS server block in frontend/nginx.conf is the entire cutover.
VERIFICATION_URL_BASE=http://VPS_IP:8080/verify-email
PASSWORD_RESET_URL_BASE=http://VPS_IP:8080/reset-password
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ---- Compose / deploy knobs ----
HOST_PORT=8080
IMAGE_TAG=latest
