# Local Docker testing only — safe dummy values, localhost URLs.
# Copy to `deploy/.env` (git-ignored) and run from deploy/:
#   docker compose up --build
# Then visit http://localhost:8080

POSTGRES_USER=vertinary
POSTGRES_PASSWORD=localtestpassword
POSTGRES_DB=vertinary_db

SECRET_KEY=local-test-secret-key-not-for-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:8080

UPLOAD_DIR=/app/uploads
STORAGE_BACKEND=local
MAX_LESSON_FILE_SIZE_MB=1024
MEDIA_TOKEN_EXPIRE_MINUTES=360
UVICORN_WORKERS=2

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
VERIFICATION_EMAIL_MODE=console

VERIFICATION_URL_BASE=http://localhost:8080/verify-email
PASSWORD_RESET_URL_BASE=http://localhost:8080/reset-password
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

HOST_PORT=8080
IMAGE_TAG=local
